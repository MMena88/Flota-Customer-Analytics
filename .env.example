# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Use a Supabase secret key (or legacy service-role key).
SUPABASE_SECRET_KEY=
# Supabase Connect > Transaction pooler (port 6543); percent-encode the password.
DATABASE_URL=
# Optional migration connection: direct/session pooler, port 5432.
MIGRATION_DATABASE_URL=
# Optional trusted PEM root if your PostgreSQL endpoint uses a private CA.
DATABASE_CA_CERT=
# Existing AI integration remains optional and server-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
